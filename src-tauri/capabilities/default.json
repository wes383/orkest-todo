{
  "$schema": "../gen/schemas/desktop-schema.json",
  "capabilities": [
    {
      "identifier": "default",
      "description": "Capability for the main window",
      "windows": ["main"],
      "permissions": [
        "core:default",
        "core:window:allow-set-theme",
        "opener:default"
      ]
    },
    {
      "identifier": "focus-widget",
      "description": "Core events and manual positioning for the focus widget",
      "windows": ["focus-widget"],
      "permissions": [
        "core:default",
        "core:window:allow-set-position",
        "core:window:allow-cursor-position",
        "core:window:allow-set-theme"
      ]
    }
  ]
}
